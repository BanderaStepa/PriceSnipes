# Скопіюйте цей файл у .env і заповніть. Файл .env не потрапляє в Git.
# На Railway ці ж змінні задаються у вкладці Variables (файл .env там не потрібен).

# Токен бота від @BotFather (обов'язково)
BOT_TOKEN=

# Необов'язково: куди надсилати сповіщення «користувач запросив посилання на оплату».
# Числовий id людини або групи; дізнатися — команда /myid у боті.
# Людина-менеджер має спочатку сама натиснути /start у боті.
MANAGER_CHAT_ID=

# Необов'язково: id адміністраторів через кому — їм доступна команда /stats
ADMIN_IDS=

# Необов'язково: шлях до файлу бази даних. Зазвичай не потрібен:
#   start_bot.bat на Windows кладе базу в %LOCALAPPDATA%\TgBotDlyaRishuchih\bot.db (поза OneDrive),
#   на Railway база сама опиняється на Volume, інакше — data/bot.db у папці проєкту.
# DB_PATH=data/bot.db

# Необов'язково: рівень логування (INFO або DEBUG)
# LOG_LEVEL=INFO
